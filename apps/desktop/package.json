{
  "name": "@deepseek-ai/dsh-desktop-app",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness desktop shell for Apple Silicon and Intel macOS",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "icons": "tauri icon app-icon.svg --output src-tauri/icons",
    "predev": "pnpm run icons",
    "build": "pnpm run build:arm64",
    "build:arm64": "node scripts/build.mjs --target aarch64-apple-darwin",
    "build:x64": "node scripts/build.mjs --target x86_64-apple-darwin",
    "build:all": "node scripts/build.mjs --target aarch64-apple-darwin --target x86_64-apple-darwin",
    "build:app": "pnpm run build:app:arm64",
    "build:app:arm64": "node scripts/build.mjs --target aarch64-apple-darwin --bundles app",
    "build:app:x64": "node scripts/build.mjs --target x86_64-apple-darwin --bundles app",
    "build:debug": "pnpm run icons && tauri build --debug --no-bundle",
    "stage-runtime": "node scripts/stage-runtime.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "test:runtime": "node --test scripts/runtime-target.test.mjs",
    "check": "pnpm run icons && cargo check --manifest-path src-tauri/Cargo.toml",
    "check:arm64": "pnpm run icons && cargo check --manifest-path src-tauri/Cargo.toml --target aarch64-apple-darwin",
    "check:x64": "pnpm run icons && cargo check --manifest-path src-tauri/Cargo.toml --target x86_64-apple-darwin",
    "check:all": "pnpm run check:arm64 && pnpm run check:x64",
    "fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.7"
  }
}
